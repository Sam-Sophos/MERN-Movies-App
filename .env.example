# MERN Movies App Environment Variables
# Created: January 10, 2026
# Copy this to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/movies_app
MONGODB_TEST_URI=mongodb://localhost:27017/movies_app_test

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_EXPIRE=30d

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Add your own variables below
# TMDB_API_KEY=your_themoviedb_api_key
# CLOUDINARY_URL=your_cloudinary_url
